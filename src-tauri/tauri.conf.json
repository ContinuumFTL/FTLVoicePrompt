{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FTL Voice Prompt",
  "version": "0.1.0",
  "identifier": "com.ftlvoice.prompt",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FTL Voice Prompt",
        "width": 820,
        "height": 460,
        "minWidth": 760,
        "minHeight": 430,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
